{
  "baseline_model": {
    "name": "nanochat",
    "reason": "V3 is designed for shared-tokenizer nanochat comparison.",
    "role": "from-scratch local smoke and later one-GPU signal testing"
  },
  "dataset_manifest": "data/developmental_graph/experiments/procedural_foundation_v3/datasets/manifest.json",
  "experiment_id": "procedural_foundation_v3",
  "format": {
    "prompt_template": "{input}\n",
    "target_template": "{target}"
  },
  "frozen_commands": {
    "procedural_plain_text": "python3 scripts/train_tiny_causal_lm.py --config data/developmental_graph/experiments/procedural_foundation_v3/training_config.json --variant procedural_plain_text --dry-run",
    "procedural_relation_first_then_text": "python3 scripts/train_tiny_causal_lm.py --config data/developmental_graph/experiments/procedural_foundation_v3/training_config.json --variant procedural_relation_first_then_text --dry-run",
    "procedural_relation_scaffolded": "python3 scripts/train_tiny_causal_lm.py --config data/developmental_graph/experiments/procedural_foundation_v3/training_config.json --variant procedural_relation_scaffolded --dry-run"
  },
  "output_root": "runs/procedural_foundation_v3/nanochat",
  "schema_version": "0.1.0",
  "training": {
    "max_seq_length": 512,
    "note": "Use nanochat conversion script before training; this config is a dataset contract, not a full nanochat run config.",
    "seed": 1729
  }
}
