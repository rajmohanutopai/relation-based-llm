{
  "baseline_model": {
    "name": "HuggingFaceTB/SmolLM2-135M",
    "reason": "Use dry-run compatibility checks; actual foundation test should use nanochat.",
    "role": "format validation only before nanochat from-scratch training"
  },
  "dataset_manifest": "data/developmental_graph/experiments/core5_v0_foundation/datasets/manifest.json",
  "experiment_id": "core5_v0_foundation",
  "format": {
    "prompt_template": "{input}\n",
    "target_template": "{target}"
  },
  "frozen_commands": {
    "foundation_plain_text": "python3 scripts/train_tiny_causal_lm.py --config data/developmental_graph/experiments/core5_v0_foundation/training_config.json --variant foundation_plain_text --dry-run",
    "foundation_relation_first_then_text": "python3 scripts/train_tiny_causal_lm.py --config data/developmental_graph/experiments/core5_v0_foundation/training_config.json --variant foundation_relation_first_then_text --dry-run",
    "foundation_relation_scaffolded": "python3 scripts/train_tiny_causal_lm.py --config data/developmental_graph/experiments/core5_v0_foundation/training_config.json --variant foundation_relation_scaffolded --dry-run"
  },
  "notes": [
    "This config is for JSONL format checks only.",
    "The intended training path is nanochat from scratch with a shared tokenizer."
  ],
  "output_root": "runs/core5_v0_foundation/smollm2_135m",
  "schema_version": "0.1.0",
  "training": {
    "gradient_accumulation_steps": 8,
    "learning_rate": 5e-05,
    "logging_steps": 10,
    "max_seq_length": 256,
    "num_train_epochs": 3,
    "per_device_eval_batch_size": 1,
    "per_device_train_batch_size": 1,
    "save_total_limit": 2,
    "seed": 1729,
    "warmup_ratio": 0.03,
    "weight_decay": 0.0
  }
}
