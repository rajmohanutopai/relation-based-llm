{
  "baseline_model": {
    "name": "HuggingFaceTB/SmolLM2-135M",
    "reason": "Keep the same model as physical_v0 and physical_v0_1 so the comparison isolates candidate selection.",
    "role": "tiny causal-transformer closed-vocabulary candidate-selection baseline"
  },
  "dataset_manifest": "data/developmental_graph/experiments/physical_v0_2/datasets/manifest.json",
  "experiment_id": "physical_v0_2",
  "format": {
    "prompt_template": "### Input:\n{input}\n\n### Response:\n",
    "target_template": "{target}"
  },
  "frozen_commands": {
    "generate_heldout": "python3 scripts/generate_heldout_outputs.py --config data/developmental_graph/experiments/physical_v0_2/training_config.json --model-dir runs/physical_v0_2/smollm2_135m/candidate_selection/final --prompts data/developmental_graph/experiments/physical_v0_2/heldout_prompts.jsonl --output runs/physical_v0_2/smollm2_135m/candidate_selection/heldout_outputs_candidate_selection.jsonl --variant candidate_selection --prompt-style raw",
    "score_candidate_selection": "python3 scripts/run_candidate_selection_evaluation.py data/developmental_graph/experiments/physical_v0_2/heldout.json data/developmental_graph/experiments/physical_v0_2/heldout_prompts.jsonl runs/physical_v0_2/smollm2_135m/candidate_selection/heldout_outputs_candidate_selection.jsonl --output runs/physical_v0_2/smollm2_135m/candidate_selection/heldout_candidate_scores.json",
    "train": "python3 scripts/train_tiny_causal_lm.py --config data/developmental_graph/experiments/physical_v0_2/training_config.json --variant candidate_selection"
  },
  "notes": [
    "This experiment tests recognition among candidate graph IDs, not open-ended graph ID generation.",
    "Candidate lists include the correct labels plus deterministic hard negatives from nearby graph layers or relation types.",
    "Held-out prompts remain outside training."
  ],
  "output_root": "runs/physical_v0_2/smollm2_135m",
  "schema_version": "0.1.0",
  "training": {
    "gradient_accumulation_steps": 8,
    "learning_rate": 5e-05,
    "logging_steps": 10,
    "max_seq_length": 512,
    "num_train_epochs": 10,
    "per_device_eval_batch_size": 1,
    "per_device_train_batch_size": 1,
    "save_total_limit": 2,
    "seed": 1729,
    "warmup_ratio": 0.03,
    "weight_decay": 0.0
  }
}
