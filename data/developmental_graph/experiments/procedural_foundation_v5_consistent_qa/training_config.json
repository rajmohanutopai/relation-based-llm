{
  "baseline_model": {
    "name": "nanochat",
    "reason": "V5 tests relation scaffolding with stable word QA prompts and targets.",
    "role": "from-scratch local comparison after V4 ambiguity check"
  },
  "dataset_manifest": "data/developmental_graph/experiments/procedural_foundation_v5_consistent_qa/datasets/manifest.json",
  "experiment_id": "procedural_foundation_v5_consistent_qa",
  "format": {
    "prompt_template": "{input}\\n",
    "target_template": "{target}"
  },
  "frozen_commands": {
    "word_plain_qa": "python3 scripts/create_nanochat_pretrain_shards.py --train-jsonl data/developmental_graph/experiments/procedural_foundation_v5_consistent_qa/datasets/word_plain_qa/train.jsonl --val-jsonl data/developmental_graph/experiments/procedural_foundation_v5_consistent_qa/datasets/word_plain_qa/dev.jsonl --base-dir runs/procedural_foundation_v5_consistent_qa/nanochat/word_plain_qa --mode input_target",
    "word_relation_scaffolded_qa": "python3 scripts/create_nanochat_pretrain_shards.py --train-jsonl data/developmental_graph/experiments/procedural_foundation_v5_consistent_qa/datasets/word_relation_scaffolded_qa/train.jsonl --val-jsonl data/developmental_graph/experiments/procedural_foundation_v5_consistent_qa/datasets/word_relation_scaffolded_qa/dev.jsonl --base-dir runs/procedural_foundation_v5_consistent_qa/nanochat/word_relation_scaffolded_qa --mode input_target"
  },
  "output_root": "runs/procedural_foundation_v5_consistent_qa/nanochat",
  "schema_version": "0.1.0",
  "training": {
    "max_seq_length": 256,
    "note": "Use scripts/create_nanochat_pretrain_shards.py before nanochat training.",
    "seed": 1729
  }
}
