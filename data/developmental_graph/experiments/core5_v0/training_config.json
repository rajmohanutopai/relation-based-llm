{
  "baseline_model": {
    "name": "HuggingFaceTB/SmolLM2-135M",
    "reason": "Use the existing tiny local baseline before spending GPU money.",
    "role": "core5 local sanity baseline"
  },
  "dataset_manifest": "data/developmental_graph/experiments/core5_v0/datasets/manifest.json",
  "experiment_id": "core5_v0",
  "format": {
    "prompt_template": "### Input:\n{input}\n\n### Response:\n",
    "target_template": "{target}"
  },
  "frozen_commands": {
    "plain_text": "python3 scripts/train_tiny_causal_lm.py --config data/developmental_graph/experiments/core5_v0/training_config.json --variant plain_text",
    "relation_first_then_text": "python3 scripts/train_tiny_causal_lm.py --config data/developmental_graph/experiments/core5_v0/training_config.json --variant relation_first_then_text",
    "relation_scaffolded": "python3 scripts/train_tiny_causal_lm.py --config data/developmental_graph/experiments/core5_v0/training_config.json --variant relation_scaffolded"
  },
  "notes": [
    "This is a JSONL model-ready curriculum, not a shared-tokenizer nanochat run yet.",
    "Run dry-runs before training.",
    "Held-out transfer prompts remain outside training."
  ],
  "output_root": "runs/core5_v0/smollm2_135m",
  "schema_version": "0.1.0",
  "training": {
    "gradient_accumulation_steps": 8,
    "learning_rate": 5e-05,
    "logging_steps": 10,
    "max_seq_length": 512,
    "num_train_epochs": 3,
    "per_device_eval_batch_size": 1,
    "per_device_train_batch_size": 1,
    "save_total_limit": 2,
    "seed": 1729,
    "warmup_ratio": 0.03,
    "weight_decay": 0.0
  }
}
