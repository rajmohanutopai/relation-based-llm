{
  "baseline_model": {
    "name": "HuggingFaceTB/SmolLM2-135M",
    "reason": "Use dry-run compatibility checks; actual procedural test should use nanochat.",
    "role": "format validation only before nanochat from-scratch training"
  },
  "dataset_manifest": "data/developmental_graph/experiments/procedural_foundation_v0/datasets/manifest.json",
  "experiment_id": "procedural_foundation_v0",
  "format": {
    "prompt_template": "{input}\n",
    "target_template": "{target}"
  },
  "frozen_commands": {
    "procedural_plain_text": "python3 scripts/train_tiny_causal_lm.py --config data/developmental_graph/experiments/procedural_foundation_v0/training_config.json --variant procedural_plain_text --dry-run",
    "procedural_relation_first_then_text": "python3 scripts/train_tiny_causal_lm.py --config data/developmental_graph/experiments/procedural_foundation_v0/training_config.json --variant procedural_relation_first_then_text --dry-run",
    "procedural_relation_scaffolded": "python3 scripts/train_tiny_causal_lm.py --config data/developmental_graph/experiments/procedural_foundation_v0/training_config.json --variant procedural_relation_scaffolded --dry-run"
  },
  "output_root": "runs/procedural_foundation_v0/smollm2_135m",
  "schema_version": "0.1.0",
  "training": {
    "gradient_accumulation_steps": 8,
    "learning_rate": 5e-05,
    "logging_steps": 10,
    "max_seq_length": 512,
    "num_train_epochs": 3,
    "per_device_eval_batch_size": 1,
    "per_device_train_batch_size": 1,
    "save_total_limit": 2,
    "seed": 1729,
    "warmup_ratio": 0.03,
    "weight_decay": 0.0
  }
}
