{
  "baseline_model": {
    "name": "HuggingFaceTB/SmolLM2-135M",
    "reason": "Keep the same baseline model while changing only the candidate-selection task shape.",
    "role": "tiny causal-transformer binary candidate-scoring baseline"
  },
  "dataset_manifest": "data/developmental_graph/experiments/physical_v0_3/datasets/manifest.json",
  "experiment_id": "physical_v0_3",
  "format": {
    "prompt_template": "### Input:\n{input}\n\n### Response:\n",
    "target_template": "{target}"
  },
  "frozen_commands": {
    "generate_heldout": "python3 scripts/generate_heldout_outputs.py --config data/developmental_graph/experiments/physical_v0_3/training_config.json --model-dir runs/physical_v0_3/smollm2_135m/binary_candidate_scoring/final --prompts data/developmental_graph/experiments/physical_v0_3/heldout_prompts.jsonl --output runs/physical_v0_3/smollm2_135m/binary_candidate_scoring/heldout_outputs_binary_candidate_scoring.jsonl --variant binary_candidate_scoring --prompt-style raw --max-new-tokens 8",
    "score_binary_candidate_scoring": "python3 scripts/run_binary_candidate_evaluation.py data/developmental_graph/experiments/physical_v0_3/heldout.json data/developmental_graph/experiments/physical_v0_3/heldout_prompts.jsonl runs/physical_v0_3/smollm2_135m/binary_candidate_scoring/heldout_outputs_binary_candidate_scoring.jsonl --output runs/physical_v0_3/smollm2_135m/binary_candidate_scoring/heldout_binary_candidate_scores.json",
    "score_binary_candidate_scoring_topk": "python3 scripts/run_binary_candidate_evaluation.py data/developmental_graph/experiments/physical_v0_3/heldout.json data/developmental_graph/experiments/physical_v0_3/heldout_prompts.jsonl runs/physical_v0_3/smollm2_135m/binary_candidate_scoring/heldout_logits_binary_candidate_scoring.jsonl --selection-mode top_expected_count --output runs/physical_v0_3/smollm2_135m/binary_candidate_scoring/heldout_binary_candidate_scores_logits_topk.json",
    "score_logits": "python3 scripts/score_binary_candidate_logits.py --config data/developmental_graph/experiments/physical_v0_3/training_config.json --model-dir runs/physical_v0_3/smollm2_135m/binary_candidate_scoring/final --prompts data/developmental_graph/experiments/physical_v0_3/heldout_prompts.jsonl --output runs/physical_v0_3/smollm2_135m/binary_candidate_scoring/heldout_logits_binary_candidate_scoring.jsonl --variant binary_candidate_scoring",
    "train": "python3 scripts/train_tiny_causal_lm.py --config data/developmental_graph/experiments/physical_v0_3/training_config.json --variant binary_candidate_scoring"
  },
  "notes": [
    "This experiment changes multi-select generation into independent binary candidate judgments.",
    "The goal is to reduce v0.2 over-selection while keeping closed-vocabulary relation supervision.",
    "Held-out prompts remain outside training."
  ],
  "output_root": "runs/physical_v0_3/smollm2_135m",
  "schema_version": "0.1.0",
  "training": {
    "gradient_accumulation_steps": 8,
    "learning_rate": 5e-05,
    "logging_steps": 10,
    "max_seq_length": 512,
    "num_train_epochs": 3,
    "per_device_eval_batch_size": 1,
    "per_device_train_batch_size": 1,
    "save_total_limit": 2,
    "seed": 1729,
    "warmup_ratio": 0.03,
    "weight_decay": 0.0
  }
}
